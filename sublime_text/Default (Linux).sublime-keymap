    { "keys": ["alt+u"], "command": "soft_undo" },
    { "keys": ["alt+w"], "command": "close"},
    { "keys": ["alt+/"], "command": "toggle_comment", "args": {"block": false} },
    { "keys": ["alt+["], "command": "unindent"},
    { "keys": ["alt+]"], "command": "indent"},
    { "keys": ["alt+shift+d"], "command": "duplicate_line" },
    { "keys": ["alt+shift+f"], "command": "show_panel", "args": {"panel": "find_in_files"} },
    { "keys": ["alt+shift+g"], "command": "find_prev" },
    { "keys": ["alt+shift+n"], "command": "new_window" },
    { "keys": ["alt+shift+p"], "command": "show_overlay", "args": {"overlay": "command_palette"} },
    { "keys": ["alt+shift+r"], "command": "goto_symbol_in_project" },
    { "keys": ["alt+shift+["], "command": "prev_view" },
    { "keys": ["alt+shift+]"], "command": "next_view" },
    { "keys": ["ctrl+f"], "command": "move", "args": {"by": "characters", "forward": true} },
    { "keys": ["ctrl+shift+f"], "command": "move", "args": {"by": "characters", "extend": true, "forward": true} },
    { "keys": ["super+f"], "command": "move", "args": {"by": "word_ends", "forward": true} },
    { "keys": ["super+shift+f"], "command": "move", "args": {"by": "word_ends", "extend": true, "forward": true} },
    { "keys": ["ctrl+b"], "command": "move", "args": {"by": "characters", "forward": false} },
    { "keys": ["ctrl+shift+b"], "command": "move", "args": {"by": "characters", "extend": true, "forward": false} },
    { "keys": ["super+b"], "command": "move", "args": {"by": "words", "forward": false} },
    { "keys": ["super+shift+b"], "command": "move", "args": {"by": "words", "extend": true, "forward": false} },
    { "keys": ["ctrl+n"], "command": "move", "args": {"by": "lines", "forward": true} },
    { "keys": ["ctrl+shift+n"], "command": "move", "args": {"by": "lines", "extend": true, "forward": true} },
    { "keys": ["super+n"], "command": "move", "args": {"by": "stops", "empty_line": true, "forward": true} },
