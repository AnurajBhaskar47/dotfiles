    { "keys": ["alt+shift+up"], "command": "noop" },
    { "keys": ["alt+shift+down"], "command": "noop" },
    { "keys": ["ctrl+k","ctrl+b"], "command": "noop" },
    { "keys": ["ctrl+k","ctrl+d"], "command": "noop" },
    { "keys": ["ctrl+k","ctrl+p"], "command": "noop" },

    // Run
    {
        "keys": ["ctrl+r"],
        "command": "view_tester",
        "args": {
            "action": "make_opd",
            "use_debugger": false
        },
        "context": [
            {
                "operand": "source.TestSyntax",
                "operator": "not_equal",
                "match_all": true,
                "key": "selector"
            }
        ]
    },

    // Run
    {
        "keys": ["ctrl+r"],
        "command": "test_manager",
        "args": {
            "action": "make_opd",
            "load_session": true,
            "use_debugger": false
        },
        "context": [
            {
                "operand": "source.TestSyntax",
                "operator": "equal",
                "match_all": true,
                "key": "selector"
            }
        ]
    },
    
]
