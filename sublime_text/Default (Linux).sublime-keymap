    { "keys": ["ctrl+shift+p"], "command": "move", "args": {"by": "lines", "extend": true, "forward": false} },
    { "keys": ["super+p"], "command": "move", "args": {"by": "stops", "empty_line": true, "forward": false} },
    { "keys": ["super+shift+p"], "command": "move", "args": {"by": "stops", "empty_line": true, "extend": true, "forward": false} },
    { "keys": ["super+m"], "command": "move_to", "args": {"to": "bol"} },
