{
	"tests_relative_dir": ".focc",
	"run_settings": [
		{
			"name": "C++",
			"extensions": ["cpp"],
			"compile_cmd": "clang++ '{source_file}' -std=c++23 -o {file_name}",
			"run_cmd": "./\"{file_name}\" {args} -debug",

			"lint_compile_cmd": "clang++ -std=c++23 '{source_file}' -I '{source_file_dir}'"
		},

		{
			"name": "Python",
			"extensions": ["py"],
			"compile_cmd": null,
			"run_cmd": "python3 '{source_file}'"
		},
		
		{
			"name": "Java",
			"extensions": ["java"],
			"compile_cmd": "javac -J-Dfile.encoding=utf8 -d \"{source_file_dir}\" \"{source_file}\"",
			"run_cmd": "java -classpath \"{source_file_dir}\" \"{file_name}\""
		}
	],	
}