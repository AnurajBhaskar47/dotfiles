[
	{ "keys": ["alt+`"], "command": "toggle_terminus_panel" },
    {
        "keys": ["ctrl+alt+t"], "command": "terminus_open", "args": {
            "cwd": "${file_path:${folder}}"
        }
    },

    // Restore ctrl+b to "move backward" behavior
    { "keys": ["ctrl+b"], "command": "move", "args": {"by": "characters", "forward": false} },
    { "keys": ["ctrl+shift+b"], "command": "move", "args": {"by": "characters", "forward": false, "extend": true} },

    // Fast Olympic Coding overrides
    // Run
    {
        "keys": ["ctrl+r"],
        "command": "view_tester",
        "args": {
            "action": "make_opd",
            "use_debugger": false
        },
        "context": [
            {
                "operand": "source.TestSyntax",
                "operator": "not_equal",
                "match_all": true,
                "key": "selector"
            }
        ]
    },

    // Run
    {
        "keys": ["ctrl+r"],
        "command": "test_manager",
        "args": {
            "action": "make_opd",
            "load_session": true,
            "use_debugger": false
        },
        "context": [
            {
                "operand": "source.TestSyntax",
                "operator": "equal",
                "match_all": true,
                "key": "selector"
            }
        ]
    },

    // Run with Debugger
    {
        "keys": ["ctrl+shift+r"],
        "command": "view_tester",
        "args": {
            "action": "make_opd",
            "use_debugger": true
        },
        "context": [
            {
                "operand": "source.TestSyntax",
                "operator": "not_equal",
                "match_all": true,
                "key": "selector"
            }
        ]
    },

    // Run with Debugger
    {
        "keys": ["ctrl+shift+r"],
        "command": "test_manager",
        "args": {
            "action": "make_opd",
            "load_session": true,
            "use_debugger": true
        },
        "context": [
            {
                "operand": "source.TestSyntax",
                "operator": "equal",
                "match_all": true,
                "key": "selector"
            }
        ]
    },

    // Toggle Right panel
    {
        "keys": ["super+k", "super+p"],
        "command": "view_tester",
        "args": {
            "action": "sync_opdebugs"
        }
    },

]
